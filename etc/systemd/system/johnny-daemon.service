# DRAFT ONLY — NOT INSTALLED ON JOHNNY. DO NOT INSTALL, ENABLE, OR START
# BEFORE PASTE W COMPLETES (after 2026-11-21 15:33 CT / 21:33Z).
# Runbook: docs/tool-install/stage1-rust-daemon-cutover.md
[Unit]
Description=Johnny Stage 1 userspace sensor daemon (rotating ring buffer consumer)
After=johnny-capture-xdp-records.service
Requires=johnny-capture-xdp-records.service
Conflicts=johnny-m1s2b-reader.service
ConditionPathExists=/usr/local/libexec/johnny/johnny-daemon
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
User=root
ExecStart=/usr/local/libexec/johnny/johnny-daemon --file-max-bytes 1073741824 --file-max-seconds 3600 --keep 200 --dir-cap-bytes 214748364800 --reserve-bytes 107374182400
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20
# Output: /var/lib/johnny/m1s2b (0700 root, files 0600).
StateDirectory=johnny/m1s2b
StateDirectoryMode=0700
UMask=0077
# Resource bounds (identical to johnny-m1s2b-reader.service).
MemoryMax=1G
MemorySwapMax=0
CPUQuota=50%
CPUAffinity=0
TasksMax=4
LimitNOFILE=64
LimitFSIZE=1025M
LimitCORE=0
Nice=10
IOSchedulingClass=idle
# No egress, enforced three ways.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=none
# Privilege: uid 0 with NO capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# /sys is read-only. The ring pin and output dir are writable.
ReadWritePaths=/sys/fs/bpf/johnny_m1s2b/m2_rb /var/lib/johnny/m1s2b
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
