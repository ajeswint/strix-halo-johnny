[Unit]
Description=Pin eno1np0 ice IRQs to Johnny capture CPUs
After=network-online.target irqbalance.service
Wants=network-online.target
ConditionPathExists=/etc/johnny/capture-cores
ConditionPathExists=/etc/johnny/irq-affinity.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/johnny/irq-affinity.sh apply
# Helper waits up to 100s for eno1np0 and 60s for tuning (step 13c).
TimeoutStartSec=210

[Install]
WantedBy=multi-user.target
