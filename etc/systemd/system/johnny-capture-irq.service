[Unit]
Description=Pin eno1np0 ice IRQs to Johnny capture CPUs
After=network-online.target irqbalance.service
Wants=network-online.target
ConditionPathExists=/etc/johnny/capture-cores
ConditionPathExists=/etc/johnny/irq-affinity.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/johnny/irq-affinity.sh apply
# Helper waits up to 100s total (one shared loop) for eno1np0 link+flags AND
# eno3 addr/route/up (step 13c, 13d); tuning is NOTE-only. 100s wait + 50s slack.
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
