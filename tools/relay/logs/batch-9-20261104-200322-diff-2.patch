fi

if [ "$paste" = 2 ]; then
# RUNS IN: SSH
# PASTE 2
# RUNS ON: JOHNNY (SSH)
set -euo pipefail
# Rollback: docs/cis-fix/batch-9.md ## Rollback. This paste disarms the timer.

if [ "$(id -u)" -ne 0 ]; then
  echo STOP-not-root
  exit 1
